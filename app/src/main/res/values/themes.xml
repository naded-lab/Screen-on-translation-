<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Tarjaman" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- ثيم شاشة البداية (Splash) - يعتمد على Splash Screen API القياسي الموفر للبطارية -->
    <style name="Theme.Tarjaman.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_primary_container</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Tarjaman</item>
    </style>
</resources>
